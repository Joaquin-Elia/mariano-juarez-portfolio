---
import "../styles/global.css";
import { ClientRouter } from "astro:transitions";

interface Props {
  title?: string;
}

const { title = "Mariano Juarez" } = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/png" href="/icon.png" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <!-- Primary Meta Tags -->
    <title>Mariano Juarez</title>
    <meta name="title" content="Mariano Juarez" />
    <meta name="description" content="" />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://marianojuarez.com.ar/" />
    <meta property="og:title" content="Mariano Juarez" />
    <meta property="og:description" content="" />
    <meta property="og:image" content="/images/poster.webp" />

    <!-- X (Twitter) -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content="https://marianojuarez.com.ar/" />
    <meta property="twitter:title" content="Mariano Juarez" />
    <meta property="twitter:description" content="" />
    <meta property="twitter:image" content="/images/poster.webp" />
    <ClientRouter />
  </head>
  <body>
    <slot />
  </body>
</html>
